# Vorlage der .env (Secrets und Overrides). Nie versionieren, nie weitergeben.
# Ablage: installiert ~/.chatexporter/.env (neben der globalen config.yaml), in der Entwicklung
# workspace/.env (bootstrap.env_file). Zusaetzlich kann jeder Storage eine eigene
# <storage>/.storage/.env haben (spezifischer als die globale).
#
# Vorrang: --set > Umgebung > Storage-.env > Storage-config.yaml > globale .env > globale config.yaml
#          > Standard (KONFIGURATION.md, Abschnitt 3).
# CHATEXPORTER_VENV_PATH gehoert NICHT hierher: die venv muss gefunden werden, bevor
# Python diese Datei laden kann. Dafuer bootstrap.venv_path in der config.yaml setzen.
# Passwoerter, Tokens und Cookies nie in eine config.yaml; nur hier oder in der Umgebung.

# Storage (Datenbestand), mit dem gearbeitet wird (Standard: ~/.chatexporter/storages/default):
# CHATEXPORTER_STORAGE=

# Ablageorte (optionale Overrides der config.yaml):
# CHATEXPORTER_DATA_ROOT=
# CHATEXPORTER_RAW_ROOT=
# CHATEXPORTER_RUNTIME_ROOT=
# CHATEXPORTER_STATUS_ROOT=
# CHATEXPORTER_EDGE_USER_DATA_DIR=

# Raw Session Updater:
# CHATEXPORTER_SOURCES=chatgpt,opencode,codex,claude

# Exporter:
# CHATEXPORTER_EXPORT_ROOT=
# CHATEXPORTER_EXPORT_FORMATS=markdown,json
# CHATEXPORTER_EXPORT_SOURCES=chatgpt

# Befehlsprotokoll:
# CHATEXPORTER_LOG_ENABLED=true
# CHATEXPORTER_LOG_DIR=
# CHATEXPORTER_LOG_ROTATION=24h
# CHATEXPORTER_LOG_RETENTION=30d

# Zeitplanung:
# CHATEXPORTER_TASK_FOLDER=\ChatExporter
# CHATEXPORTER_TASK_OWNER=chatexporter
# CHATEXPORTER_TASK_COMMAND=update --non-interactive

# ChatGPT (Browser/API):
# CHATEXPORTER_EDGE_EXE=
# CHATEXPORTER_CDP_HOST=127.0.0.1
# CHATEXPORTER_CDP_PORT=9223
# CHATEXPORTER_EDGE_LAUNCH_IF_NEEDED=true
# CHATEXPORTER_EDGE_OPEN_URL=https://chatgpt.com/
# CHATEXPORTER_EDGE_CONNECT_TIMEOUT_MS=15000
# CHATEXPORTER_INTERACTIVE_REAUTH=true
# CHATEXPORTER_LEAVE_BROWSER_RUNNING=true
# CHATEXPORTER_BROWSER_WINDOW=offscreen
# CHATEXPORTER_API_BASE_URL=https://chatgpt.com
# CHATEXPORTER_API_REQUEST_TIMEOUT_MS=120000

# ChatGPT (automatische Anmeldung; nur hier oder in der Umgebung, nie in der config.yaml):
# CHATGPT_USERNAME=name@example.org
# CHATGPT_PASSWORD=
# 2FA – empfohlen: Kennung/Alias im verschluesselten Windows-Speicher der Two-Factor Tools ...
# CHATGPT_2FA_REFERENCE=
# ... oder das Secret selbst (Base32, otpauth://totp/... oder verschluesselter Wert):
# CHATGPT_2FA_SECRET=
# CHATEXPORTER_AUTO_LOGIN=auto
# CHATEXPORTER_LOGIN_TIMEOUT_SECONDS=120

# ChatGPT (Sync):
# CHATEXPORTER_LISTING_MODE=auto
# CHATEXPORTER_LISTING_LIMIT=100
# CHATEXPORTER_RECENT_MAX_PAGES=3
# CHATEXPORTER_RECENT_CONFIRM_UNCHANGED=3
# CHATEXPORTER_FETCH_FILES=true
# CHATEXPORTER_FETCH_TEXTDOCS=true
# CHATEXPORTER_RETRY_PENDING_FILES=true
# CHATEXPORTER_CONTINUE_ON_ERROR=true
# CHATEXPORTER_MAX_ERRORS_PER_RUN=5
# CHATEXPORTER_RATE_LIMIT_WAIT_MINUTES=0

# Entwicklungsmodus (nur fuer Tests; laedt absichtlich nur einen Teil der Daten):
# CHATEXPORTER_DEV_MODE=0
# CHATEXPORTER_DEV_LISTING_MAX_PAGES=3
# CHATEXPORTER_DEV_CONVERSATION_FETCHES=5
